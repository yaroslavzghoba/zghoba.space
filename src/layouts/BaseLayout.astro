---
import 'sys.override/dist/style.css';               // design system.
import '../styles/global.css';                      // global styles.
const { title, description, lang } = Astro.props;   // get basic page parameters.
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="so-texture-paper">
    <!-- Insert content from the template here -->
    <slot />
  </body>
   <script src="../scripts/main.js"></script> 
</html>
