---
import BaseLayout from '../layouts/BaseLayout.astro';  // base layout.
const { lang, t } = Astro.props;                       // get a locale and an obj with translations.
---

<BaseLayout title={t.pageTitle} description={t.pageDescription} lang={lang}>

  <!-- Navigation Bar -->
  <nav class="so-sys-nav" aria-label="Primary navigation">
    <div class="so-nav-brand">{t.navBrand}</div>
    <div class="so-nav-links">
      <a class="so-nav-link so-active" href="#so-welcome">{t.navWelcome}</a>
      <a class="so-nav-link" href="#so-project1">{t.navProject1}</a>
      <a class="so-nav-link" href="#so-project2">{t.navProject2}</a>
      <a class="so-nav-link" href="#so-project3">{t.navProject3}</a>
      <a class="so-nav-link" href="#so-project4">{t.navProject4}</a>
      <a class="so-nav-link" href="#so-contact">{t.navContact}</a>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="so-scroll-container" id="main-content">

    <!-- Greeting Section -->
    <section class="so-section so-hero-section" id="so-welcome" aria-labelledby="welcome-title">
      <div class="so-section-content so-hero-layout">
        <article class="so-neo-card so-bg-orange so-hero-card">
          <div class="so-card-header"><span class="so-mono-text">{t.greetingSectionFirstCardHeader}</span></div>
          <!-- <p class="so-kicker">{t.greetingSectionFirstCardAboveTitle}</p> -->
          <h1 id="welcome-title">{t.greetingSectionFirstCardTitle}</h1>
          <p>{t.greetingSectionFirstCardDescription}</p>
          <a class="so-neo-btn so-bg-yellow" href={t.greetingSectionFirstCardGetLinksBtnLink} target="_blank" rel="noreferrer">{t.greetingSectionFirstCardGetLinksBtnText}</a>
        </article>

        <section class="so-data-panel so-bg-cream so-telemetry" aria-labelledby="telemetry-title">
          <div class="so-card-header"><span class="so-mono-text" id="telemetry-title">{t.greetingSectionSecondCardHeader}</span></div>
          <dl>
            <div><dt>{t.greetingSectionSecondCardAgePropName}</dt><dd>{t.greetingSectionSecondCardAge}</dd></div>
            <div><dt>{t.greetingSectionSecondCardBasePropName}</dt><dd>{t.greetingSectionSecondCardBase}</dd></div>
            <div><dt>{t.greetingSectionSecondCardPrimaryPropName}</dt><dd>{t.greetingSectionSecondCardPrimary}</dd></div>
            <div><dt>{t.greetingSectionSecondCardChannelPropName}</dt><dd>{t.greetingSectionSecondCardChannel}</dd></div>
          </dl>
          <span class="so-signal-mark" aria-hidden="true">✳</span>
        </section>
      </div>
      <span class="so-scroll-cue so-metadata">{t.greetingSectionScrollHint}</span>
    </section>

    <!-- Project 1 Section -->
    <section class="so-section so-projects-section" id="so-project1" aria-labelledby="projects-title">
      <div class="so-bg-video-wrapper" aria-hidden="true">
        <video muted loop playsinline preload="none"><source src="https://www.pexels.com/download/video/39005131/" type="video/mp4" /></video>
        <div class="so-video-overlay"></div>
      </div>
      <div class="so-section-content so-projects-layout">
        <header class="so-section-heading"><span class="so-mono-text">{t.firstProjectSectionHeader}</span><h2 id="projects-title">{t.firstProjectSectionTitle}</h2><p>{t.firstProjectSectionDescription}</p></header>
        <article class="so-neo-card so-bg-sage so-project-card">
          <div class="so-card-header"><span class="so-mono-text">{t.firstProjectCardHeader}</span></div>
          <h3>{t.firstProjectCardTitle}</h3>
          <p>{t.firstProjectCardDescription}</p>
          <ul class="so-tag-list" aria-label="Papagei Backend technologies">
            <li>{t.firstProjectCardTags[0]}</li>
            <li>{t.firstProjectCardTags[1]}</li>
            <li>{t.firstProjectCardTags[2]}</li>
            <li>{t.firstProjectCardTags[3]}</li>
            <li>{t.firstProjectCardTags[4]}</li>
            <li>{t.firstProjectCardTags[5]}</li>
          </ul>
          <a class="so-neo-btn so-bg-yellow" href={t.firstProjectCardLink} target="_blank" rel="noreferrer">{t.firstProjectCardLinkText}</a>
        </article>
      </div>
    </section>

    <!-- Project 2 Section -->
    <section class="so-section so-projects-section" id="so-project2" aria-labelledby="projects-title">
      <div class="so-bg-video-wrapper" aria-hidden="true">
        <video muted loop playsinline preload="none"><source src="https://www.pexels.com/download/video/28077111/" type="video/mp4" /></video>
        <div class="so-video-overlay"></div>
      </div>
      <div class="so-section-content so-projects-layout">
        <header class="so-section-heading"><span class="so-mono-text">{t.secondProjectSectionHeader}</span><h2 id="projects-title">{t.secondProjectSectionTitle}</h2><p>{t.secondProjectSectionDescription}</p></header>
        <article class="so-neo-card so-bg-orange so-project-card">
          <div class="so-card-header"><span class="so-mono-text">{t.secondProjectCardHeader}</span></div>
          <h3>{t.secondProjectCardTitle}</h3>
          <p>{t.secondProjectCardDescription}</p>
          <ul class="so-tag-list" aria-label="KotCore technologies">
            <li>{t.secondProjectCardTags[0]}</li>
            <li>{t.secondProjectCardTags[1]}</li>
            <li>{t.secondProjectCardTags[2]}</li>
            <li>{t.secondProjectCardTags[3]}</li>
            <li>{t.secondProjectCardTags[4]}</li>
          </ul>
          <a class="so-neo-btn so-bg-yellow" href={t.secondProjectCardLink} target="_blank" rel="noreferrer">{t.secondProjectCardLinkText}</a>
        </article>
      </div>
    </section>

    <!-- Project 3 Section -->
    <section class="so-section so-projects-section" id="so-project3" aria-labelledby="projects-title">
      <div class="so-bg-video-wrapper" aria-hidden="true">
        <video muted loop playsinline preload="none"><source src="https://www.pexels.com/download/video/28077111/" type="video/mp4" /></video>
        <div class="so-video-overlay"></div>
      </div>
      <div class="so-section-content so-projects-layout">
        <header class="so-section-heading"><span class="so-mono-text">{t.thirdProjectSectionHeader}</span><h2 id="projects-title">{t.thirdProjectSectionTitle}</h2><p>{t.thirdProjectSectionDescription}</p></header>
        <article class="so-neo-card so-bg-yellow so-project-card">
          <div class="so-card-header"><span class="so-mono-text">{t.thirdProjectCardHeader}</span></div>
          <h3>{t.thirdProjectCardTitle}</h3>
          <p>{t.thirdProjectCardDescription}</p>
          <ul class="so-tag-list" aria-label="KotCore technologies">
            <li>{t.thirdProjectCardTags[0]}</li>
            <li>{t.thirdProjectCardTags[1]}</li>
            <li>{t.thirdProjectCardTags[2]}</li>
            <li>{t.thirdProjectCardTags[3]}</li>
            <li>{t.thirdProjectCardTags[4]}</li>
            <li>{t.thirdProjectCardTags[5]}</li>
          </ul>
          <a class="so-neo-btn so-bg-sage" href={t.thirdProjectCardLink} target="_blank" rel="noreferrer">{t.thirdProjectCardLinkText}</a>
        </article>
      </div>
    </section>

    <!-- Project 4 Section -->
    <section class="so-section so-projects-section" id="so-project4" aria-labelledby="projects-title">
      <div class="so-bg-video-wrapper" aria-hidden="true">
        <video muted loop playsinline preload="none"><source src="https://www.pexels.com/download/video/40426495/" type="video/mp4" /></video>
        <div class="so-video-overlay"></div>
      </div>
      <div class="so-section-content so-projects-layout">
        <header class="so-section-heading"><span class="so-mono-text">{t.fourthProjectSectionHeader}</span><h2 id="projects-title">{t.fourthProjectSectionTitle}</h2><p>{t.fourthProjectSectionDescription}</p></header>
        <div class="so-project-grid">
          <article class="so-neo-card so-bg-green so-project-card">
            <div class="so-card-header"><span class="so-mono-text">{t.fourthProjectFirstCardHeader}</span></div>
            <h3>{t.fourthProjectFirstCardTitle}</h3>
            <p>{t.fourthProjectFirstCardDescription}</p>
            <ul class="so-tag-list" aria-label="KotCore technologies">
              <li>{t.fourthProjectFirstCardTags[0]}</li>
              <li>{t.fourthProjectFirstCardTags[1]}</li>
              <li>{t.fourthProjectFirstCardTags[2]}</li>
              <li>{t.fourthProjectFirstCardTags[3]}</li>
            </ul>
            <a class="so-neo-btn so-bg-orange" href={t.fourthProjectFirstCardLink} target="_blank" rel="noreferrer">{t.fourthProjectFirstCardLinkText}</a>
          </article>
          <article class="so-neo-card so-bg-teal so-project-card">
            <div class="so-card-header"><span class="so-mono-text">{t.fourthProjectSecondCardHeader}</span></div>
            <h3>{t.fourthProjectSecondCardTitle}</h3>
            <p>{t.fourthProjectSecondCardDescription}</p>
            <ul class="so-tag-list" aria-label="Papagei Backend technologies">
              <li>{t.fourthProjectSecondCardTags[0]}</li>
              <li>{t.fourthProjectSecondCardTags[1]}</li>
              <li>{t.fourthProjectSecondCardTags[2]}</li>
              <li>{t.fourthProjectSecondCardTags[3]}</li>
              <li>{t.fourthProjectSecondCardTags[4]}</li>
            </ul>
            <a class="so-neo-btn so-bg-yellow" href={t.fourthProjectSecondCardLink} target="_blank" rel="noreferrer">{t.fourthProjectSecondCardLinkText}</a>
          </article>
        </div>
        <a class="so-neo-btn so-bg-cream so-template-link" href={t.fourthProjectSectionSeeMoreBtnLink}>{t.fourthProjectSectionSeeMoreBtnText}</a>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="so-section so-contact-section" id="so-contact" aria-labelledby="contact-title">
      <article class="so-neo-card so-bg-cream so-contact-card">
        <div class="so-card-header"><span class="so-mono-text">{t.contactSectionCardFirstHeader}</span></div>
        <p class="so-kicker">{t.contactSectionCardSecondHeader}</p>
        <h2 id="contact-title">{t.contactSectionCardTitle}</h2>
        <p>{t.contactSectionCardDescription}</p>
        <a class="so-neo-btn so-giant-btn so-bg-orange" href={t.contactSectionCardBtnLink}>{t.contactSectionCardBtnText}</a>
        <div class="so-contact-footer so-metadata"><span>{t.contactSectionCardFooter[0]}</span><span>{t.contactSectionCardFooter[1]}</span></div>
      </article>
    </section>
  </main>
</BaseLayout>
